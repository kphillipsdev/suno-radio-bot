# =============================================================================
# Copy this file to `.env` and set values locally. Never commit `.env`.
# Use a different Discord bot token than Subot Live (separate application).
# =============================================================================

# --- Required ---
BOT_TOKEN=

# --- Database (optional) ---
# SUNO_RADIO_DB=./suno_radio.db

# --- Bot file logging (optional; still goes to journald when run under systemd) ---
# BOT_LOG_FILE=./logs/subot-private.log
# BOT_LOG_MAX_BYTES=10485760
# BOT_LOG_BACKUPS=5

# --- Radio / text channel (optional) ---
# Text channel for now-playing + autofill messages. Strongly recommended when
# running contests in a separate channel — without this, cards follow whatever
# channel last invoked a command. Right-click the text channel -> Copy ID.
# RADIO_CONTROL_CHANNEL=

# --- Volume ---
# DEFAULT_VOLUME=1.0

# --- Autofill (idle radio) ---
# AUTOFILL_FEATURE=1
# AUTOFILL_DELAY_SEC=30
# GAME_AUTOFILL_DELAY_SEC=60      # wait before autofill resumes after a guessing game
# AUTOFILL_MAX_PULL=50
# AUTOFILL_LIKES_PER_USER=5
# AUTOFILL_CSV_MIN_RATIO=0.6      # share of each autofill batch pulled from autofill.csv (0.0-1.0)
# AUTOFILL_CSV_FRESH_TAIL_SIZE=10 # most-recent CSV rows that get priority (so /request plays soon)
# DEFAULT_AUTOFILL_URL=
# DEFAULT_AUTOFILL_CSV=
# AUTOFILL_CSV_PATH=              # per-guild override; usually set via !autofill set

# --- User song requests (/request command) ---
# REQUEST_MAX_PER_USER=5
# REQUEST_CHANNEL=                # text channel ID; restricts !request prefix only (slash works anywhere)

# Pinned voice channel for autofill. When set, autofill will always play in
# this VC and will silently move the bot back if it drifts elsewhere (e.g.
# after a contest listening-party). Manual !play/!playlist ignore this pin.
# Right-click the voice channel in Discord (Developer Mode on) -> Copy ID.
# RADIO_VC_ID=

# --- Audio / FFmpeg tuning ---
# VOICE_BITRATE_KBPS=128          # omit to use Discord default Opus bitrate
# PREBUFFER_SECONDS=0.5
# FADE_IN_SECONDS=0.5
# FADE_IN_STEPS=20
# FADE_OUT_SECONDS=1.0
# FADE_OUT_STEPS=20
# FFMPEG_PROBESIZE=8M
# FFMPEG_ANALYZEDURATION=5M
# FFMPEG_THREAD_QUEUE_SIZE=1024
# FFMPEG_RW_TIMEOUT_US=30000000   # 30s in microseconds
# FFMPEG_MAX_DELAY_US=20000000
# Silence pad in milliseconds at the start of each track (masks Discord voice
# warm-up clipping). Set to 0 to disable.
# STARTUP_ADELAY_MS=500
# Silence pad in milliseconds at the end of each track (prevents abrupt cut
# before the song fully finishes). Set to 0 to disable.
# OUTRO_APAD_MS=750

# --- Queue / skip behaviour ---
# SKIP_IF_REQUESTER_LEFT=1
# SHOW_SKIP_MESSAGE=1
# QUEUE_LIMIT_DEFAULT_ENABLED=1
# QUEUE_LIMIT_MAX_PER_ADD=200
# QUEUE_MAX_PER_USER=3

# --- Now Playing card cleanup ---
# REMOVE_NP_AFTER_SONGS=1
# REMOVE_NON_AUTOFILL_NP=0

# --- Playlist clear policy ---
# CLEAR_PLAYLISTS_ON_STOP=0
# CLEAR_PLAYLISTS_ON_RELOAD=0

# --- yt-dlp download cache ---
# YTDLP_DOWNLOAD_DIR=             # defaults to system temp

# --- Image cache ---
# IMAGE_CACHE_DIR=./images
# IMAGE_CACHE_SIZE=500
# IMAGE_DOWNLOAD_TIMEOUT=15

# --- Anonymous song contests (visuals) ---
# Label shown on contest cards when a contest has no name of its own.
# CONTEST_LABEL=Anonymous Contest
# Folder for server-hosted contest art. Drop files here and swap per contest.
# CONTEST_IMAGE_DIR=images/contest
# Default poster (shown on the "listening party starting" + voting cards). Per-contest
# override: drop images/contest/<contest-name-slug>_poster.png (e.g. summer_jam_poster.png).
# CONTEST_POSTER_PATH=images/contest/poster.png
# Default per-entry thumbnail (used when a blurred cover can't be made). Per-contest
# override: images/contest/<slug>_entry.png.
# CONTEST_ENTRY_THUMB_PATH=images/contest/entry.png
# Force all entry cards to the same width via a transparent spacer of this pixel
# width. Set to 0 to disable and let Discord auto-size each card.
# CONTEST_CARD_WIDTH=512
# Set to 0 to disable the blurred "?" cover thumbnails on entry cards.
# CONTEST_BLUR_COVERS=1
# CONTEST_BLUR_CACHE_DIR=images/contest/blurred
# Fun GIFs for the voting + winner cards. Single default file each; drop several
# GIFs into the *_GIF_DIR folders for a random pick each time. Per-contest override:
# images/contest/<slug>_voting.gif / <slug>_winner.gif.
# CONTEST_VOTING_GIF=images/contest/voting.gif
# CONTEST_WINNER_GIF=images/contest/winner.gif
# CONTEST_VOTING_GIF_DIR=images/contest/voting_gifs
# CONTEST_WINNER_GIF_DIR=images/contest/winner_gifs

# --- Web dashboard (Discord OAuth2) ---
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DASHBOARD_SECRET_KEY=
# DASHBOARD_BASE_URL=
# WRAPPED_DASHBOARD_ENABLED=0
